# Clave pública de Mercado Pago (developers.mercadopago.com → Tu integración → Credenciales)
# Debe ser la misma aplicación que el ACCESS_TOKEN del backend.
REACT_APP_MP_PUBLIC_KEY=APP_USR-tu-public-key

# URL del backend en producción (obligatorio en Vercel si el API está en otro dominio)
# Ejemplo: https://swgfsm-api.onrender.com/api
# Si usas proxy /api en el mismo dominio, puedes dejar: /api
REACT_APP_API_URL=https://tu-backend.com/api
